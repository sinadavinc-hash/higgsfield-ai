# Gemini API
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Higgsfield API
NEXT_PUBLIC_HIGGSFIELD_API_KEY=your_higgsfield_api_key_here

# App Config
NEXT_PUBLIC_APP_NAME=Higgsfield AI Studio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random User Generation
NEXT_PUBLIC_GENERATE_RANDOM_USER=true
NEXT_PUBLIC_DEVICE_MODELS_APPLE=iPhone16,iPhone15,iPhone14,iPhone13,iPad,iPad Air,iPad Pro,iPad Mini
NEXT_PUBLIC_DEVICE_MODELS_GOOGLE=Pixel9,Pixel8,Pixel7,GalaxyS24,GalaxyS23,GalaxyA54,OnePlus12
